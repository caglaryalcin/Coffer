.DS_Store
*.pem

# Repository-only branding exports and source artwork
/assets/

# Media files are excluded from the Docker build context by default.
# Runtime assets under public/ are explicitly restored below.
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.avif
**/*.bmp
**/*.tif
**/*.tiff
**/*.ico
**/*.svg
**/*.psd
**/*.ai
**/*.eps
**/*.sketch

!public/
!public/**

# Canonical sources used by the service-brand generator during prebuild.
!scripts/brand-assets/*.svg
